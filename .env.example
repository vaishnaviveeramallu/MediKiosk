# =====================================================================
# MEDIKIOSK — PRODUCTION & LOCAL ENVIRONMENT CONFIGURATION TEMPLATE
# =====================================================================
# Copy this file to backend/.env and frontend/.env.local (or set as system environment variables).
# DO NOT COMMIT REAL CREDENTIALS OR API KEYS TO VERSION CONTROL.

# ---------------------------------------------------------------------
# BACKEND: Core Infrastructure
# ---------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017
DATABASE_NAME=medikiosk
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ---------------------------------------------------------------------
# BACKEND: Authentication & Session Security (JWT)
# ---------------------------------------------------------------------
JWT_SECRET_KEY=change_this_to_a_cryptographically_secure_random_string_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------------------------------------------------------------------
# BACKEND: AI Clinical Summarization & Adaptive Intake
# ---------------------------------------------------------------------
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
AI_PROVIDER=heuristic
AI_TIMEOUT_SECONDS=8.0
MAX_ADAPTIVE_QUESTIONS=15

# ---------------------------------------------------------------------
# BACKEND: OCR Engine Configuration (Tesseract OCR)
# ---------------------------------------------------------------------
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSDATA_PREFIX=C:\Program Files\Tesseract-OCR\tessdata
OCR_MAX_PAGES=10
OCR_TIMEOUT_SECONDS=30.0
OCR_DEFAULT_LANGUAGES=eng+hin

# ---------------------------------------------------------------------
# BACKEND: Ayushman Bharat Digital Mission (ABDM) / ABHA
# When unconfigured, MediKiosk safely reports integration status as NOT_CONFIGURED
# ---------------------------------------------------------------------
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_BASE_URL=
ABDM_BRIDGE_URL=

# ---------------------------------------------------------------------
# BACKEND: HL7 FHIR Server Interoperability
# When unconfigured, MediKiosk exports valid HL7 FHIR R4 Bundles locally
# ---------------------------------------------------------------------
FHIR_SERVER_URL=
FHIR_API_KEY=
FHIR_VERSION=R4

# ---------------------------------------------------------------------
# BACKEND: Hospital Information System (HIS) / EMR Gateway
# When unconfigured, MediKiosk safely reports connectivity as NOT_CONFIGURED
# ---------------------------------------------------------------------
HIS_EMR_BASE_URL=
HIS_EMR_API_KEY=
HIS_EMR_HOSPITAL_ID=

# ---------------------------------------------------------------------
# FRONTEND: Next.js Client Configuration
# ---------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
