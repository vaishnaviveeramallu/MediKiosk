# Core Infrastructure
MONGODB_URI=mongodb://127.0.0.1:27017
DATABASE_NAME=medikiosk
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Authentication & Session Security (JWT)
JWT_SECRET_KEY=change_this_to_a_cryptographically_secure_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Clinical Summarization & Adaptive Intake
AI_API_KEY=your_gemini_or_openai_api_key_here
AI_MODEL=gemini-1.5-flash
AI_PROVIDER=heuristic
AI_TIMEOUT_SECONDS=8.0
MAX_ADAPTIVE_QUESTIONS=15

# OCR Engine Configuration (Tesseract)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSDATA_PREFIX=C:\Program Files\Tesseract-OCR\tessdata
OCR_MAX_PAGES=10
OCR_TIMEOUT_SECONDS=30.0
OCR_DEFAULT_LANGUAGES=eng+hin

# Ayushman Bharat Digital Mission (ABDM) / ABHA Configuration
# When unconfigured, MediKiosk safely marks ABHA integration as NOT_CONFIGURED
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_BASE_URL=
ABDM_BRIDGE_URL=

# HL7 FHIR Server Configuration
# When unconfigured, MediKiosk generates valid FHIR R4 bundles locally without remote upload
FHIR_SERVER_URL=
FHIR_API_KEY=
FHIR_VERSION=R4

# Hospital Information System (HIS) / Electronic Medical Records (EMR)
# When unconfigured, MediKiosk marks HIS/EMR connectivity as NOT_CONFIGURED
HIS_EMR_BASE_URL=
HIS_EMR_API_KEY=
HIS_EMR_HOSPITAL_ID=
